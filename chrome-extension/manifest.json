{
  "manifest_version": 3,
  "name": "Multilingual Fake News Detector",
  "version": "0.1.0",
  "description": "Scans H1/H2 headings (Tamil/Sinhala) and shows classifier predictions only.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Scan Headings",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/logo_1.png",
    "48": "icons/logo_2.png",
    "128": "icons/logo_3.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
